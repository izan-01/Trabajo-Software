2.  realizar un gráfico de barras con los votos totales de cada partido las elecciones de 2022

-   barras ordenadas de más a menos votos
-   colorinchis

```{r}
#el geom_bar solo cuenta cosas, por si lo que quisieramos graficar consistiera en contar columnas pero como aquí queríamos scara los votos por partido había que sumarlo y por tanto y por eso hemos hecho 

#fct_reorder es para ordenador los valores de una variable factor (una variable cualitativa nominal)
resumen2022 <- 
  datos |> 
  filter(year(convocatoria)== "2022") |> 
  summarise("voto_por_partido" = sum(votos_partido), .by = partido)
  
resumen2022



gg1 <- 
  ggplot(resumen2022) +
  geom_col(aes(x = fct_reorder(partido, -voto_por_partido), 
               y = voto_por_partido, 
               fill = fct_reorder(partido, -voto_por_partido)), alpha = 0.6) +
  scale_fill_manual(values = c("blue", "red", "green", "pink", "yellow", "orange", "grey")) +
  labs( x = "partidos",
        y = "votos por partido",
        title = "VOTOS POR PARTIDO", 
        fill = "Nombre partidos")
gg1

```

```{r}

resumen <- 
